<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.nlog-project.org/schemas/NLog.xsd NLog.xsd"
      autoReload="true"
      throwExceptions="false"
      internalLogLevel="Off"
	  internalLogFile="${basedir}/logs/nlog-internal.log">

  <variable name="logDir" value="${basedir}/logs" />
  <variable name="logLayout" value="${longdate} ${uppercase:${level}} ${message}" />
  <variable name="logDate" value="${date:format=yyyy-MM-dd}" />

  <targets>
	  <target xsi:type="file" name="Sbme2ServerTarget"
			  fileName="${var:logDir}/Sbme2Server_${var:logDate}.log"
			  createDirs="true"
			  keepFileOpen="false"
			  layout="${var:logLayout}"
			  async="true" />

	  <target xsi:type="file" name="BacpacTarget"
			  fileName="${var:logDir}/Bacpac_${var:logDate}.log"
			  createDirs="true"
			  keepFileOpen="false"
			  layout="${var:logLayout}"
			  async="true" />
  </targets>
	
  <rules>
	  <logger name="Sbme2Server"
			  minlevel="Debug"
			  writeTo="Sbme2ServerTarget,mAppTarget"
			  final="true" />
	  <logger name="BacpacLogger"
			  minlevel="Debug"
			  writeTo="BacpacTarget,mAppTarget"
			  final="true" />
  </rules>
</nlog>
